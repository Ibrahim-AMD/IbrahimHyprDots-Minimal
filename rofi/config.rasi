/* Rofi Theme - Quicksand / Dark Glass */

* {
    font:                       "Quicksand 12";
    
    /* Color Palette */
    bg-base:                    #1D2021BF; /* 75% opacity (#1D2021 + BF alpha) */
    bg-search:                  #394144;
    bg-selected:                #405359;
    
    fg-main:                    #FBF1C7;
    fg-muted:                   #A89984;
    
    background-color:           transparent;
    text-color:                 @fg-main;
    
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

window {
    background-color:           @bg-base;
    text-color:                 @fg-main;
    border-radius:              15px;
    width:                      600px;
    padding:                    16px;
}

mainbox {
    children:                   [ "inputbar", "listview" ];
    spacing:                    12px;
}

/* --- Search Bar --- */
inputbar {
    background-color:           @bg-search;
    border-radius:              15px;
    padding:                    12px 16px;
    children:                   [ "entry" ];
}

entry {
    /* Removed placeholder text entirely */
    text-color:                 @fg-main;
}

/* --- App List --- */
listview {
    lines:                      8;
    columns:                    1;
    fixed-height:               false;
    spacing:                    8px;
    cycle:                      true;
    scrollbar:                  false;
}

element {
    padding:                    12px 16px;
    border-radius:              15px;
    /* Explicitly hide icons */
    children:                   [ "element-text" ];
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg-main;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg-main;
}

element selected.normal {
    background-color:           @bg-selected;
    text-color:                 #FFFFFF;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
}